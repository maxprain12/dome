{
  "name": "@dome/browser-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dome WebExtension (Chrome, Edge, Firefox, Safari) for capturing contacts, notes and links.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build -b chrome && wxt build -b edge && wxt build -b firefox --mv3 && wxt build -b safari",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:safari": "wxt build -b safari",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip -b chrome && wxt zip -b firefox",
    "package:safari": "node ./scripts/package-safari.mjs",
    "test": "wxt prepare && vitest run",
    "test:e2e": "playwright test --config playwright.config.ts",
    "typecheck": "wxt prepare && tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@milkdown/crepe": "^7.21.2",
    "@milkdown/kit": "^7.21.2",
    "@milkdown/react": "^7.21.2",
    "@milkdown/utils": "^7.21.2",
    "i18next": "^25.10.10",
    "react-i18next": "^16.6.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "@hugeicons/react": "^1.1.9",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@shadcn/react": "^0.2.1",
    "@fontsource-variable/inter": "^5.2.8",
    "tw-animate-css": "^1.4.0",
    "shadcn": "^4.13.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@wxt-dev/module-react": "^1.1.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wxt": "^0.20.11",
    "@base-ui/react": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "tailwindcss": "^4.3.2",
    "@tailwindcss/vite": "^4.3.2"
  }
}
