{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": [
        "../../app/*"
      ]
    }
  },
  "include": [
    "src",
    "entrypoints",
    "wxt.config.ts",
    "vitest.config.ts",
    ".wxt/wxt.d.ts",
    "../../app/types/global.d.ts"
  ],
  "extends": "./.wxt/tsconfig.json"
}
