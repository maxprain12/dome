{
  "name": "@dome/ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-provider LLM layer (SDK connectors). Node-only.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./oauth": {
      "types": "./dist/oauth.d.ts",
      "import": "./dist/oauth.js",
      "require": "./dist/oauth.js"
    },
    "./compat": {
      "types": "./dist/compat.d.ts",
      "import": "./dist/compat.js"
    },
    "./providers/*": {
      "types": "./dist/providers/*.d.ts",
      "import": "./dist/providers/*.js"
    },
    "./api/*": {
      "types": "./dist/api/*.d.ts",
      "import": "./dist/api/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1127.0",
    "@earendil-works/pi-telemetry": "1.0.0",
    "@google/genai": "^2.21.0",
    "@mistralai/mistralai": "^2.2.1",
    "@smithy/node-http-handler": "^4.12.1",
    "@smithy/types": "^4.19.0",
    "http-proxy-agent": "^9.1.0",
    "https-proxy-agent": "^9.1.0",
    "openai": "^7.19.0",
    "partial-json": "^0.1.7",
    "typebox": "^1.3.27"
  }
}
