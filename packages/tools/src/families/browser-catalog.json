[
  {
    "type": "function",
    "function": {
      "name": "browser_configure",
      "description": "Configure this isolated local browser before navigation. Chromium launch options are optional; Electron is the default.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "options": {
            "type": "object",
            "properties": {
              "backend": {
                "default": "electron",
                "type": "string",
                "enum": [
                  "electron",
                  "chromium"
                ]
              },
              "profile": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,80}$"
              },
              "keepAlive": {
                "default": false,
                "type": "boolean"
              },
              "viewport": {
                "default": {
                  "width": 1280,
                  "height": 720
                },
                "type": "object",
                "properties": {
                  "width": {
                    "type": "integer",
                    "minimum": 320,
                    "maximum": 4096
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 240,
                    "maximum": 4096
                  }
                },
                "required": [
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              "deviceScaleFactor": {
                "default": 1,
                "type": "number",
                "minimum": 0.5,
                "maximum": 4
              },
              "userAgent": {
                "type": "string",
                "maxLength": 1000
              },
              "mobile": {
                "default": false,
                "type": "boolean"
              },
              "allowedDomains": {
                "default": [],
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 250
                }
              },
              "prohibitedDomains": {
                "default": [],
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 250
                }
              },
              "permissions": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "clipboard-read",
                    "notifications",
                    "media",
                    "geolocation"
                  ]
                }
              },
              "proxy": {
                "type": "string",
                "format": "uri"
              },
              "waitAfterLoadMs": {
                "default": 250,
                "type": "integer",
                "minimum": 0,
                "maximum": 5000
              },
              "waitBetweenActionsMs": {
                "default": 0,
                "type": "integer",
                "minimum": 0,
                "maximum": 5000
              },
              "useVision": {
                "default": "auto",
                "type": "string",
                "enum": [
                  "auto",
                  "on",
                  "off"
                ]
              },
              "highlightElements": {
                "default": false,
                "type": "boolean"
              },
              "crossOriginFrames": {
                "default": false,
                "type": "boolean"
              },
              "acceptDownloads": {
                "default": false,
                "type": "boolean"
              },
              "autoDownloadPdfs": {
                "default": false,
                "type": "boolean"
              },
              "record": {
                "default": "off",
                "type": "string",
                "enum": [
                  "off",
                  "gif",
                  "mp4"
                ]
              },
              "recordFps": {
                "default": 10,
                "type": "integer",
                "minimum": 1,
                "maximum": 30
              },
              "recordHar": {
                "default": false,
                "type": "boolean"
              },
              "traces": {
                "default": false,
                "type": "boolean"
              },
              "headless": {
                "default": true,
                "type": "boolean"
              },
              "executablePath": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "channel": {
                "type": "string",
                "enum": [
                  "chrome",
                  "chrome-beta",
                  "msedge"
                ]
              },
              "cdpUrl": {
                "type": "string",
                "format": "uri"
              },
              "args": {
                "default": [],
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 2000
                }
              },
              "env": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "devtools": {
                "default": false,
                "type": "boolean"
              },
              "ignoreDefaultArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "backend",
              "keepAlive",
              "viewport",
              "deviceScaleFactor",
              "mobile",
              "allowedDomains",
              "prohibitedDomains",
              "permissions",
              "waitAfterLoadMs",
              "waitBetweenActionsMs",
              "useVision",
              "highlightElements",
              "crossOriginFrames",
              "acceptDownloads",
              "autoDownloadPdfs",
              "record",
              "recordFps",
              "recordHar",
              "traces",
              "headless",
              "args",
              "devtools"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "options"
        ],
        "additionalProperties": false
      }
    }
  },
