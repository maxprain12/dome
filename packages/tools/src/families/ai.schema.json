[
  {
    "type": "function",
    "function": {
      "name": "image_generate",
      "description": "Generate an image with the configured image provider and save it as a Dome resource. Provider credentials remain in main. Return resource IDs and observed usage; do not invent output on provider errors.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "project_id": {
            "type": "string"
          }
        },
        "required": [
          "prompt"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "ai_classify",
      "description": "Classify structured state with an available classifier model. Ask choice, score or boolean questions with explicit criteria. Returns typed answers and adapter-provided probabilities; never inferred probabilities from a chat response.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "state": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "questions": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "choice"
                    },
                    "instructions": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    },
                    "criteria": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string",
                        "maxLength": 4000
                      }
                    }
                  },
                  "required": [
                    "type",
                    "instructions",
                    "criteria"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "score"
                    },
                    "instructions": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    },
                    "criteria": {
                      "minItems": 1,
                      "maxItems": 100,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "maxLength": 4000
                      }
                    }
                  },
                  "required": [
                    "type",
                    "instructions",
                    "criteria"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "bool"
                    },
                    "instructions": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    },
                    "criteria": {
                      "type": "object",
                      "properties": {
                        "true": {
                          "type": "string",
                          "maxLength": 4000
                        },
                        "false": {
                          "type": "string",
                          "maxLength": 4000
                        }
                      },
                      "required": [
                        "true",
                        "false"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "type",
                    "instructions",
                    "criteria"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "temperature": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10
          }
        },
        "required": [
          "state",
          "questions"
        ],
        "additionalProperties": false,
        "$defs": {
          "__schema0": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              }
            ]
          }
        }
      }
    }
  }
]
