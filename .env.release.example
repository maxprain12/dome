# Copy to .env.release.local (gitignored). Never commit real values.

# Common (baked into the app by scripts/embed-env.cjs and Vite)
DOME_GOOGLE_DRIVE_CLIENT_ID=
DOME_GOOGLE_DRIVE_CLIENT_SECRET=
DOME_GOOGLE_CALENDAR_CLIENT_ID=
DOME_GOOGLE_CALENDAR_CLIENT_SECRET=
DOME_PROVIDER_URL=https://dome-provider.dowi.es
DOME_GITHUB_CLIENT_ID=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
VITE_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=alder-dario-velasquez-obando
SENTRY_PROJECT=electron

# Signing mac (Developer ID in the keychain is enough if CSC_LINK is empty)
CSC_LINK=
CSC_KEY_PASSWORD=
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# Signing win
# CSC_LINK=base64 pfx
# CSC_KEY_PASSWORD=

# Upload (build machines): write-only on the staging bucket
RELEASE_S3_ENDPOINT=
RELEASE_S3_REGION=auto
RELEASE_S3_ACCESS_KEY=
RELEASE_S3_SECRET_KEY=
RELEASE_S3_BUCKET_STAGING=dome-releases-staging

# Publish machine only
RELEASE_PUBLIC_S3_ENDPOINT=
RELEASE_PUBLIC_S3_REGION=auto
RELEASE_PUBLIC_S3_ACCESS_KEY=
RELEASE_PUBLIC_S3_SECRET_KEY=
RELEASE_S3_BUCKET_PUBLIC=dome-releases
RELEASE_PUBLIC_BASE_URL=https://dl.dowi.es

# Webhooks
LANDING_DEPLOY_WEBHOOK_URL=
COOLIFY_TOKEN=
GITHUB_BRIDGE_REPO=maxprain12/dome
